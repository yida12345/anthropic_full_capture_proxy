# 代理监听地址（Harbor/Claude Code 的 ANTHROPIC_BASE_URL 指向这里）
PROXY_LISTEN_HOST=0.0.0.0
PROXY_LISTEN_PORT=30303

# Anthropic 兼容上游 base URL，不要包含 /v1/messages
UPSTREAM_URL=http://10.17.10.67:31542

# 每次评测 run 建议使用一个独立目录
CAPTURE_LOG_DIR=./capture_logs/example_run
UPSTREAM_TIMEOUT_SECONDS=300

# 有界后台采集：每条最多积压 8 MiB、同时最多 64 个采集任务。
# 超限停止对应采集并报告故障，继续转发响应。
CAPTURE_BUFFER_BYTES=8388608
CAPTURE_MAX_PENDING=64

# 自动归档默认关闭；取消注释目录即可启用。每个 run 使用独立归档子目录。
# CAPTURE_ARCHIVE_DIR=/mnt/trajectory_archive/example_run
CAPTURE_ARCHIVE_INTERVAL_SECONDS=3600
# 已收尾 capture 在本地至少保留 24 小时再归档。
CAPTURE_ARCHIVE_MIN_AGE_SECONDS=86400
CAPTURE_ARCHIVE_BATCH_SIZE=1000
# true：归档读回校验并提交索引后清理原件；false：仅压缩备份。
CAPTURE_ARCHIVE_DELETE_SOURCE=false

# 不在代理中配置 API key。Harbor/Claude Code 发来的认证头会原样转发。
