b && (total / nmemb) != size) return NULL; /* overflow */\n  if (fail_ge >= 0 && (long)total >= fail_ge) return NULL;\n  if (fail_after >= 0 && nalloc++ >= fail_after) return NULL;\n  if (budget >= 0 && used + (long)total > budget) return NULL;\n  void *p = real_calloc(nmemb, size);\n  if (p && budget >= 0) used += (long)total;\n  return p;\n}\n\nvoid *realloc(void *ptr, size_t size) {\n  init();\n  if (fail_ge >= 0 && (long)size >= fail_ge) return NULL;\n  if (fail_after >= 0 && nalloc++ >= fail_after) return NULL;\n  if (budget >= 0 && used + (long)size > budget) return NULL;\n  /* best-effort budget tracking: don't subtract old size */\n  void *p = real_realloc(ptr, size);\n  if (p && budget >= 0) used += (long)size;\n  return p;\n}\n\nvoid free(void *ptr) {\n  init();\n  real_free(ptr);\n}"}}],"model":"DeepSeek-V4-Flash-0731","usage":{"input_tokens":62341,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"797f274e-a18b-426c-8154-8e32629cfe04","uuid":"df2adad8-f05b-4f8f-ad41-af8140afc76b"}
